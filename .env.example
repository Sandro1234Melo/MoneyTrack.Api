# Configure estes valores no host de produção (Render, Azure, etc.).
# Nunca envie um arquivo .env com valores reais ao repositório.
ConnectionStrings__DefaultConnection=Host=...;Port=5432;Database=...;Username=...;Password=...
Jwt__Key=gere-uma-chave-aleatoria-com-pelo-menos-32-bytes
Jwt__Issuer=MoneyTrack.Api
Jwt__Audience=MoneyTrack.Web
# Necessário para o scanner de notas. Não coloque a chave no appsettings.json.
OpenAI__ApiKey=sk-...
# Opcional; gpt-4o-mini é o padrão.
OpenAI__ReceiptScannerModel=gpt-4o-mini
